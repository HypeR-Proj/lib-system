{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "lib-system",
  "kind": "library",
  "tests": [
    [
      "cmake",
      "-S",
      "stdlib/system/tests/unit",
      "-B",
      "target/module-lib",
      "-DCMAKE_C_COMPILER=clang",
      "-DHYPER_ABI_INCLUDE_DIR={system}/sdk/abi/include"
    ],
    [
      "cmake",
      "--build",
      "target/module-lib"
    ],
    [
      "ctest",
      "--test-dir",
      "target/module-lib",
      "--output-on-failure"
    ]
  ],
  "artifacts": [
    {
      "source": "{sdk}/lib/libsystem.so",
      "destination": "lib64/{arch}-hyper-hyper/libsystem.so",
      "mode": "0755",
      "profiles": [
        "system",
        "development"
      ],
      "environment": "system"
    }
  ],
  "build": {
    "actions": {
      "all": [
        [
          "make",
          "-C",
          "{workspace}",
          "sdk"
        ]
      ],
      "build": [
        [
          "make",
          "-C",
          "{workspace}",
          "sdk"
        ]
      ]
    }
  }
}
